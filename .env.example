# ==============================================================================
# TimePulse Attendance System Environment Configuration Template
# Copy this file to .env and adjust variables as needed for your environment.
# ==============================================================================

# Database Connection
# When running with Docker Compose, set DB_HOST=db (service name).
# When running locally on host with native MySQL, set DB_HOST=127.0.0.1.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=timeclock_user
DB_PASSWORD=TimeClock@2026!
DB_NAME=timeclock_db

# MySQL Root Password (used by docker-compose for database initialization)
MYSQL_ROOT_PASSWORD=TimeClockRoot@2026!

# Server Application Port
PORT=3000

# Timezone (e.g. America/Belize, America/Chicago, America/New_York)
TZ=America/Belize

# Node Environment ('production', 'development', or 'test')
NODE_ENV=production

# Automated Biometric Clock Hardware Polling (cron syntax)
# Polls physical ZKTeco clocks on port 4370 every 1 minute. Set to "disabled" to deactivate.
DEVICE_SYNC_CRON="* * * * *"

# Legacy Access Polling (Permanently disabled - Access MDB sync decommissioned)
SYNC_CRON="disabled"
